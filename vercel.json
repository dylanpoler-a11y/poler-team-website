{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:city-homes-for-sale",
      "destination": "/api/city?slug=:city-homes-for-sale"
    },
    {
      "source": "/via-ventura",
      "destination": "/api/vv-ab/route"
    },
    {
      "source": "/kevindashboard",
      "destination": "/api/kevindashboard"
    }
  ],
  "redirects": [
    {
      "source": "/:city-condos-for-sale",
      "destination": "/:city-homes-for-sale",
      "permanent": true
    },
    {
      "source": "/thelauderdalehotel",
      "destination": "https://the-lauderdale-dashboard.netlify.app/",
      "statusCode": 308
    }
  ],
  "crons": [
    {
      "path": "/api/send-alerts",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/granola-sync",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/daily-audit",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/crm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/crm.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/crm.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/crm.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=0, stale-while-revalidate"
        }
      ]
    },
    {
      "source": "/investultralux",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    },
    {
      "source": "/investultralux/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "functions": {
    "api/city.js": {
      "includeFiles": "listing.html"
    }
  }
}
