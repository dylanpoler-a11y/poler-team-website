{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/thelauderdalehotel",
      "destination": "https://the-lauderdale-dashboard.netlify.app/"
    },
    {
      "source": "/thelauderdalehotel/:path*",
      "destination": "https://the-lauderdale-dashboard.netlify.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=0, stale-while-revalidate" }
      ]
    }
  ]
}
