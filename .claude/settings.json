{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protect-locked-files.sh",
            "timeout": 10,
            "statusMessage": "Checking locked-file list"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/deploy-clean-tree.sh",
            "timeout": 15,
            "statusMessage": "Deploy gate: checking git tree"
          }
        ]
      }
    ]
  }
}
